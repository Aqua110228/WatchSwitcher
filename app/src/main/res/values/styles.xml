        <item name="android:textColor">@color/chart_chip_text</item>
        <item name="chipIconTint">@color/chart_chip_text</item>
        <item name="rippleColor">?attr/subtab_pill</item>
    </style>

    <!-- Date-step pill buttons (charts date bar, dashboard day arrows) -->
    <style name="TextAppearance.App.DateLabel" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/datestep_label</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Base: tonal dark pill, chevron on the start side -->
    <style name="Widget.App.DateStep" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
