        <item name="rippleColor">#33FFFFFF</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Chevron on the end side (right-hand group) -->
    <style name="Widget.App.DateStep.End">
        <item name="iconGravity">textEnd</item>
    </style>

    <!-- Day buttons: filled -->
    <style name="Widget.App.DateStep.Primary">
        <item name="backgroundTint">?attr/datestep_primary_bg</item>
        <item name="iconTint">?attr/datestep_primary_icon</item>
        <item name="android:textColor">?attr/datestep_primary_caption</item>
    </style>
    <style name="Widget.App.DateStep.Primary.End" parent="Widget.App.DateStep.Primary">
        <item name="iconGravity">textEnd</item>
    </style>

