        <item name="subtab_pill_on">@color/primarydark_light</item>
        <item name="subtab_text_off">?attr/colorOnSurfaceVariant</item>
        <item name="subtab_active">?attr/tab_pill</item>
        <item name="chip_border_off">?attr/stat_tile_border</item>
