    </style>

    <style name="GadgetbridgeTheme.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">?attr/toolbar_bg</item>
        <item name="android:height">52dp</item>
        <item name="titleTextStyle">@style/GadgetbridgeTheme.ToolbarTitleStyle</item>
        <item name="subtitleTextStyle">@style/GadgetbridgeTheme.ToolbarSubtitleStyle</item>
        <!-- No shadow under the bar: it showed as a gradient on the tab row below -->
        <item name="elevation">0dp</item>
        <item name="android:theme">@style/GadgetbridgeTheme.ToolbarIconOverlay</item>
    </style>
    <style name="GadgetbridgeTheme.ActionMode" parent="Widget.AppCompat.ActionMode">
        <item name="background">?attr/colorPrimary</item>
        <item name="titleTextStyle">@style/GadgetbridgeTheme.ActionModeTitleStyle</item>
        <item name="subtitleTextStyle">@style/GadgetbridgeTheme.ActionModeTitleStyle</item>
        <item name="android:theme">@style/GadgetbridgeTheme.ActionModeOverlay</item>
    </style>
    <style name="GadgetbridgeTheme.ActionModeOverlay" parent="">
        <item name="colorControlNormal">?attr/colorOnPrimary</item>
        <item name="actionmenu_icon_color">?attr/colorOnPrimary</item>
    </style>
    <style name="GadgetbridgeTheme.ActionModeCloseButton" parent="Widget.AppCompat.ActionButton">
        <item name="android:tint">?attr/colorOnPrimary</item>
    </style>
    <style name="GadgetbridgeTheme.ActionModeTitleStyle" parent="TextAppearance.Material3.ActionBar.Title">
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>
    <style name="GadgetbridgeTheme.OverflowMenuStyle" parent="Widget.Material3.PopupMenu.Overflow" />

    <!-- splash screen -->
    <style name="SplashTheme" parent="GadgetbridgeTheme.NoActionBar">
        <item name="android:statusBarColor">@color/primarydark_dark</item>
        <item name="android:navigationBarColor">@color/primarydark_dark</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

    <!-- preferences screens -->
    <style name="AppPreferenceThemeOverlay" parent="@style/PreferenceThemeOverlay">
        <item name="switchPreferenceCompatStyle">@style/AppSwitchPreference</item>
    </style>
    <style name="AppSwitchPreference" parent="@style/Preference.SwitchPreferenceCompat.Material">
        <item name="widgetLayout">@layout/preference_material_switch</item>
    </style>
    <style name="GridTile">
        <item name="android:background">?android:attr/windowBackground</item>
        <item name="android:padding">15dp</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_rowWeight">1</item>
    </style>

    <!-- Pill-style tabs (charts tabs, workout tabs, Day/Week/Month sub-tabs).
         TitleSmall's default 20sp lineHeight doesn't fit our compact pill height and clips
         text (descenders cut off), so it's brought back down close to the text size. -->
    <style name="TextAppearance.App.Tab" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight">16sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.App.TabSmall" parent="TextAppearance.App.Tab">
        <item name="android:textSize">13sp</item>
        <item name="android:lineHeight">15sp</item>
    </style>

    <!-- Top row: category tabs (charts tabs, workout Overview/Laps/Charts/Details) -->
    <style name="Widget.App.TabLayout.Pill" parent="Widget.Material3.TabLayout">
        <item name="android:background">?attr/tab_bar_bg</item>
        <item name="tabMode">scrollable</item>
        <item name="tabGravity">start</item>
        <item name="tabIndicator">@drawable/tab_indicator_pill</item>
        <item name="tabIndicatorColor">?attr/tab_pill</item>
        <item name="tabIndicatorGravity">stretch</item>
        <item name="tabIndicatorFullWidth">true</item>
        <item name="tabIndicatorAnimationMode">elastic</item>
        <item name="tabTextColor">@color/tab_text_pill</item>
        <item name="tabSelectedTextColor">?attr/tab_pill_on</item>
        <item name="tabTextAppearance">@style/TextAppearance.App.Tab</item>
        <item name="tabRippleColor">@null</item>
        <item name="tabUnboundedRipple">false</item>
        <item name="tabMinWidth">0dp</item>
        <item name="tabPaddingStart">14dp</item>
        <item name="tabPaddingEnd">14dp</item>
        <item name="tabPaddingTop">6dp</item>
        <item name="tabPaddingBottom">6dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>

    <!-- Sub row: Day / Week / Month segmented control -->
    <style name="Widget.App.TabLayout.SubPill" parent="Widget.App.TabLayout.Pill">
        <item name="android:background">@android:color/transparent</item>
        <item name="tabMode">fixed</item>
        <item name="tabGravity">fill</item>
        <item name="tabIndicator">@drawable/subtab_indicator_bar</item>
        <item name="tabIndicatorGravity">bottom</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabIndicatorColor">?attr/subtab_active</item>
        <item name="tabTextColor">@color/subtab_text_pill</item>
        <item name="tabSelectedTextColor">?attr/subtab_active</item>
        <item name="tabTextAppearance">@style/TextAppearance.App.TabSmall</item>
        <item name="tabPaddingTop">4dp</item>
        <item name="tabPaddingBottom">4dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <!-- Chart metric-selector chips (e.g. sleep overlay Heart rate/SpO2, race predictor metric
         chips). Background stays transparent in both states; selection is shown only via the
         accent-colored text and border, rather than the default Choice chip's background recolor
         (often very saturated in this app's accent themes). -->
    <style name="Widget.App.Chip.Chart" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chart_chip_background</item>
        <item name="chipStrokeColor">@color/chart_chip_stroke</item>
