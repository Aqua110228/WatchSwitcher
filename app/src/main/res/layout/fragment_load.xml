<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/date_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="20sp"
            android:textColor="?attr/textColorPrimary"
            android:layout_marginTop="15dp"
            />

        <LinearLayout
            android:id="@+id/training_load_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="@dimen/chart_section_spacing"
                android:layout_marginBottom="@dimen/chart_section_spacing"
                android:orientation="vertical"
                >

                <ImageView
                    android:id="@+id/acute_load_ratio_gauge"
                    android:layout_width="150dp"
                    android:layout_height="75dp"
                    android:layout_centerHorizontal="true"
                    android:scaleType="fitStart" />

                <TextView
                    android:id="@+id/acute_load_ratio_gauge_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="28dp"
                    android:text="@string/stats_empty_value"
                    android:textColor="?attr/textColorPrimary"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/acute_load_ratio_gauge_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/acute_load_ratio_gauge_value"
                    android:layout_centerHorizontal="true"
                    android:text="" />

            </RelativeLayout>

            <nodomain.freeyourgadget.gadgetbridge.activities.workouts.SectionHeaderView
                android:id="@+id/acute_load_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:sectionTitle="@string/training_acute_load" />
            <com.github.mikephil.charting.charts.CombinedChart
                android:id="@+id/acute_load_chart"
                android:layout_width="fill_parent"
                android:layout_height="250sp"
                android:layout_weight="2" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/load_chart_data_type_group"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                app:selectionRequired="true" />

            <LinearLayout
                android:id="@+id/acute_chronic_load_stats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:orientation="vertical" />
        </LinearLayout>

        <nodomain.freeyourgadget.gadgetbridge.activities.workouts.SectionHeaderView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/chart_section_spacing"
            app:sectionTitle="@string/training_daily_load" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="250sp">
            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/daily_load_chart"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:layout_weight="2" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/weekly_load_stats_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
